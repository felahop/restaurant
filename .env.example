# Публичный адрес сайта (для canonical, Open Graph, sitemap). Без слэша в конце.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Для локальной разработки: docker compose up -d
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant?schema=public"

# Секрет для подписей (адрес доставки, сессии). Не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Отключить телеметрию Next.js (необязательно)
NEXT_TELEMETRY_DISABLED=1

# Яндекс Карты, Static API (статичная карта в блоке «Как нас найти»). Без ключа показывается схема.
# Ключ: https://developer.tech.yandex.ru — сервис «Static API». Используется только на сервере.
YANDEX_MAPS_STATIC_API_KEY=

# Подсказки адресов и координаты. GEO_PROVIDER=yandex|dadata|mock (по умолчанию — yandex при наличии ключей, иначе mock).
# Яндекс: https://developer.tech.yandex.ru — продукты «Геосаджест» и «API Геокодера» (ключи разные).
GEO_PROVIDER=
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
# DaData (альтернатива): https://dadata.ru/profile/#info
DADATA_API_KEY=

# Telegram-уведомления о заказах и бронях (без персональных данных гостей). Без них — запись в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Онлайн-оплата. PAYMENT_PROVIDER=mock — тестовая заглушка (деньги не списываются), yookassa — ЮKassa.
PAYMENT_PROVIDER=mock
# ЮKassa: личный кабинет → Интеграция → Ключи API. URL для уведомлений: https://<домен>/api/payments/webhook/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Проверять, что уведомление пришло с IP-адресов ЮKassa (нужен прокси, который перезаписывает X-Forwarded-For).
YOOKASSA_CHECK_IP=true

# Только для автотестов: множитель лимитов частоты запросов. В продакшене не задавайте.
# RATE_LIMIT_SCALE=50

# Остальные переменные (SMS) появятся на своих этапах.
