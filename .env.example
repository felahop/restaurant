# Публичный адрес сайта (для canonical, Open Graph, sitemap). Без слэша в конце.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Для локальной разработки: docker compose up -d
DATABASE_URL="postgresql://restaurant:restaurant@localhost:5432/restaurant?schema=public"

# Секрет для подписей (адрес доставки, сессии). Не короче 32 символов. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Отключить телеметрию Next.js (необязательно)
NEXT_TELEMETRY_DISABLED=1

# Яндекс Карты, Static API (статичная карта в блоке «Как нас найти»). Без ключа показывается схема.
# Ключ: https://developer.tech.yandex.ru — сервис «Static API». Используется только на сервере.
YANDEX_MAPS_STATIC_API_KEY=

# Яндекс Карты, JavaScript API v3 — карта зон на странице «Доставка» и в админке. Без ключа — фирменная схема.
# Ключ попадает в браузер: в кабинете разработчика ограничьте его адресом сайта (HTTP Referer).
YANDEX_MAPS_JS_API_KEY=
# Адрес загрузки API. TODO: сверить с документацией при подключении ключа.
# YANDEX_MAPS_JS_URL=https://api-maps.yandex.ru/v3/

# Подсказки адресов и координаты. GEO_PROVIDER=yandex|dadata|mock (по умолчанию — yandex при наличии ключей, иначе mock).
# Яндекс: https://developer.tech.yandex.ru — продукты «Геосаджест» и «API Геокодера» (ключи разные).
GEO_PROVIDER=
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
# DaData (альтернатива): https://dadata.ru/profile/#info
DADATA_API_KEY=

# Telegram-уведомления о заказах и бронях (без персональных данных гостей). Без них — запись в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# О предзаказе ресторан узнаёт за N минут до времени (N — в админке, «Настройки»). Пока открыта лента заказов,
# напоминания уходят сами; для надёжности добавьте на сервере cron с этим секретом (см. README).
CRON_SECRET=

# Онлайн-оплата. PAYMENT_PROVIDER=mock — тестовая заглушка (деньги не списываются), yookassa — ЮKassa.
PAYMENT_PROVIDER=mock
# ЮKassa: личный кабинет → Интеграция → Ключи API. URL для уведомлений: https://<домен>/api/payments/webhook/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Проверять, что уведомление пришло с IP-адресов ЮKassa (нужен прокси, который перезаписывает X-Forwarded-For).
YOOKASSA_CHECK_IP=true
# Чеки 54-ФЗ через «Чеки от ЮKassa»: позиции, НДС и почта покупателя передаются с каждым платежом.
# Значения выбирает бухгалтер по справочнику ЮKassa (vat_code, tax_system_code, payment_subject, payment_mode).
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_RECEIPT_PAYMENT_SUBJECT=commodity
YOOKASSA_RECEIPT_PAYMENT_MODE=full_prepayment

# Пароли сотрудников, которых создаёт сид при пустой базе (owner — владелец, manager — менеджер).
# Не задано — сид сгенерирует пароли и напечатает их один раз. Ещё сотрудника: см. README.
ADMIN_OWNER_PASSWORD=
ADMIN_MANAGER_PASSWORD=

# Хранилище фото: local (папка UPLOAD_DIR) или s3 (S3-совместимое, например Yandex Object Storage).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета для ссылок на фото, например https://storage.yandexcloud.net/<bucket>
S3_PUBLIC_URL=

# Только для автотестов: множитель лимитов частоты запросов. В продакшене не задавайте.
# RATE_LIMIT_SCALE=50

# Остальные переменные (SMS) появятся на своих этапах.
