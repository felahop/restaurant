# Переменные для сервера (docker-compose.prod.yml). Скопируйте в .env.production и заполните.
# Файл с настоящими значениями в git не добавляйте.

# Домен сайта (на него Caddy получит HTTPS-сертификат) и полный адрес — для ссылок, sitemap и платежей.
DOMAIN=sumibi.example
NEXT_PUBLIC_SITE_URL=https://sumibi.example

# Пароль базы (любая длинная случайная строка: openssl rand -base64 24).
POSTGRES_PASSWORD=

# Секрет приложения: подписи адресов, кодов входа, тестовых платежей. Не короче 32 символов: openssl rand -base64 48
APP_SECRET=

# Пароли первых сотрудников (создаются при первом сиде). Потом смените в админке.
ADMIN_OWNER_PASSWORD=
ADMIN_MANAGER_PASSWORD=

# Оплата: yookassa — боевая, mock — тестовая заглушка.
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CHECK_IP=true
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=

# Адреса и карты (без ключей — демо-справочник и схема зон).
GEO_PROVIDER=
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=
DADATA_API_KEY=
YANDEX_MAPS_STATIC_API_KEY=
YANDEX_MAPS_JS_API_KEY=

# Уведомления ресторану и напоминания о предзаказах.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=

# Вход по SMS: до подключения сервиса вход в кабинет на боевом сайте выключен.
SMS_PROVIDER=demo

# Фото: local — том uploads; s3 — объектное хранилище.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

NEXT_TELEMETRY_DISABLED=1
